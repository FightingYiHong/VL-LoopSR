# Copy to .env, edit local values, and never commit .env.

# OpenAI-compatible endpoint used by VEGA-SR.
LLMSR_AGENT_API_BASE=http://127.0.0.1:8001/v1
LLMSR_AGENT_API_KEY=EMPTY
LLMSR_AGENT_MODEL=Qwen3-VL-32B-Instruct

# Optional role-specific override. By default the same endpoint is used.
# LLMSR_PLANNER_API_BASE=http://127.0.0.1:8001/v1
# LLMSR_PLANNER_API_KEY=EMPTY
# LLMSR_PLANNER_MODEL=Qwen3-VL-32B-Instruct

# Download/cache roots created by `bash run_experiment.sh prepare ...`.
HF_HOME=.cache/huggingface
# LLMSRBench is access-gated; accept its terms, then use `hf auth login` or:
# HF_TOKEN=hf_...
LLMSRBENCH_ROOT=data/external/llmsrbench
LLMSRBENCH_HDF5=data/external/llmsrbench/lsr_bench_data.hdf5
SRBENCH_ROOT=data/external/srbench
SRBENCH_DATASETS_INFO_CSV=data/external/srbench/docs/csv/datasets_info.csv
SRSD_ROOT=data/external/srsd-benchmark/resource/datasets/srsd

# Nothing expensive runs unless enabled. Use MAX_CASES=2 for a smoke run.
RUN_OURS=0
RUN_BASELINES=0
RUN_LLM_SR=0
RUN_ICSR=0
RUN_SFT=0
RUN_ABLATION=0
RUN_MULTIMODAL=0
RUN_AGENTIC=0
MAX_CASES=0

# Optional third-party method checkouts; these are intentionally not committed.
# OFFICIAL_LLMSR_ROOT=data/external/methods/LLM-SR
# OFFICIAL_ICSR_ROOT=data/external/methods/In-Context-Symbolic-Regression
