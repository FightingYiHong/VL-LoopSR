# Copy this file to `.env` and edit local values.
# Do not commit `.env`.

# Repository root. Usually no need to edit.
LLMSR_ROOT=.

# OpenAI-compatible endpoint used by VL-LoopSR.
# For local vLLM servers without auth, keep the key as EMPTY.
LLMSR_AGENT_API_BASE=http://127.0.0.1:8001/v1
LLMSR_AGENT_API_KEY=EMPTY
LLMSR_AGENT_MODEL=Qwen/Qwen2.5-VL-32B-Instruct

# Shared defaults used by scripts/test_fey.py.
LLMSR_DEFAULT_API_BASE=http://127.0.0.1:8001/v1
LLMSR_DEFAULT_API_KEY=EMPTY
LLMSR_DEFAULT_MODEL=Qwen/Qwen2.5-VL-32B-Instruct

# Optional role-specific overrides.
# LLMSR_PLANNER_API_BASE=http://127.0.0.1:8001/v1
# LLMSR_PLANNER_API_KEY=EMPTY
# LLMSR_PLANNER_MODEL=Qwen/Qwen2.5-VL-32B-Instruct

# Hugging Face cache for SLDBench.
HF_HOME=.cache/huggingface
HF_DATASETS_OFFLINE=0
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# Optional LLMSRBench local download.
# LLMSRBENCH_ROOT=data/llmsrbench
# LLMSRBENCH_HDF5=data/llmsrbench/lsr_bench_data.hdf5

# Optional SRBench metadata mirror. The bundled PMLB package can be used as a
# fallback for many SRBench/Feynman cases.
# SRBENCH_ROOT=srbench
# SRBENCH_DATASETS_INFO_CSV=srbench/docs/csv/datasets_info.csv

# Official baseline checkouts, only needed when LAUNCH_OFFICIAL_* flags are set.
# OFFICIAL_LLMSR_ROOT=external_repos/LLM-SR
# OFFICIAL_ICSR_ROOT=external_repos/In-Context-Symbolic-Regression
